<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             x:Class="MauiApp1.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Entrar"
             BackgroundColor="White"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="28,20" Spacing="14">

            <Image Source="ilustracao_login.jpg"
                   HeightRequest="230"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <Label Text="PsicViewer" Style="{StaticResource TituloTela}" HorizontalOptions="Center" />
            <Label Text="Monitoramento de humor e suporte psicológico"
                   TextColor="{StaticResource CinzaMedio}"
                   FontSize="13"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,10" />

            <Label Text="E-mail" Style="{StaticResource RotuloCampo}" />
            <Border Style="{StaticResource CampoTexto}">
                <Entry Text="{Binding Email}" Placeholder="seu@email.com" Keyboard="Email" VerticalOptions="Center" />
            </Border>

            <Label Text="Senha" Style="{StaticResource RotuloCampo}" />
            <Border Style="{StaticResource CampoTexto}">
                <Entry Text="{Binding Senha}" Placeholder="Sua senha" IsPassword="True" VerticalOptions="Center" />
            </Border>

            <Label Text="{Binding MensagemErro}" Style="{StaticResource TextoErro}" Margin="0,4,0,0" />

            <Button Text="Entrar"
                    Style="{StaticResource BotaoPrimario}"
                    Command="{Binding EntrarCommand}"
                    Margin="0,18,0,0" />

            <ActivityIndicator IsRunning="{Binding Carregando}"
                                IsVisible="{Binding Carregando}"
                                Color="{StaticResource AzulPrimario}" />

            <Button Text="Ainda não tenho conta — Cadastrar"
                    Style="{StaticResource BotaoSecundario}"
                    BorderWidth="0"
                    BackgroundColor="Transparent"
                    Command="{Binding IrParaCadastroCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
