<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.ContaCriadaPage"
             Title=""
             BackgroundColor="White"
             NavigationPage.HasBackButton="False">

    <VerticalStackLayout Padding="32" Spacing="20" VerticalOptions="Center">

        <Image Source="ilustracao_contacriada.jpg"
               HeightRequest="220"
               Aspect="AspectFit"
               HorizontalOptions="Center" />

        <Label Text="Conta criada com sucesso!"
               Style="{StaticResource TituloTela}"
               HorizontalTextAlignment="Center"
               Margin="0,16,0,0" />

        <Label Text="Agora você já pode entrar com seu e-mail e senha."
               TextColor="{StaticResource CinzaMedio}"
               HorizontalTextAlignment="Center"
               FontSize="14" />

        <Button Text="Ir para o Login"
                Style="{StaticResource BotaoPrimario}"
                Clicked="OnIrParaLoginClicked"
                Margin="0,24,0,0" />

    </VerticalStackLayout>
</ContentPage>
