<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             x:Class="MauiApp1.Views.CadastroPacientePage"
             x:DataType="vm:CadastroPacienteViewModel"
             Title="Cadastro de Paciente"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="28,24" Spacing="14">

            <Label Text="Criar conta de Paciente" Style="{StaticResource TituloTela}" />
            <Label Text="Preencha seus dados para começar seu acompanhamento"
                   TextColor="{StaticResource CinzaMedio}"
                   FontSize="13"
                   Margin="0,0,0,10" />

            <Label Text="Nome completo" Style="{StaticResource RotuloCampo}" />
            <Border Style="{StaticResource CampoTexto}">
                <Entry Text="{Binding Nome}" Placeholder="Seu nome" VerticalOptions="Center" />
            </Border>

            <Label Text="E-mail" Style="{StaticResource RotuloCampo}" />
            <Border Style="{StaticResource CampoTexto}">
                <Entry Text="{Binding Email}" Placeholder="seu@email.com" Keyboard="Email" VerticalOptions="Center" />
            </Border>

            <Label Text="Telefone" Style="{StaticResource RotuloCampo}" />
            <Border Style="{StaticResource CampoTexto}">
                <Entry Text="{Binding Telefone}" Placeholder="(00) 00000-0000" Keyboard="Telephone" VerticalOptions="Center" />
            </Border>

            <Label Text="Data de Nascimento" Style="{StaticResource RotuloCampo}" />
            <Border Style="{StaticResource CampoTexto}">
                <DatePicker Date="{Binding DataNascimento}" Format="dd/MM/yyyy" VerticalOptions="Center" />
            </Border>

            <Label Text="Gênero" Style="{StaticResource RotuloCampo}" />
            <Border Style="{StaticResource CampoTexto}">
                <Picker ItemsSource="{Binding OpcoesGenero}"
                        SelectedItem="{Binding GeneroSelecionado}"
                        Title="Selecione"
                        VerticalOptions="Center" />
            </Border>

            <Label Text="Senha" Style="{StaticResource RotuloCampo}" />
            <Border Style="{StaticResource CampoTexto}">
                <Entry Text="{Binding Senha}" Placeholder="Crie uma senha" IsPassword="True" VerticalOptions="Center" />
            </Border>

            <Label Text="Confirmar senha" Style="{StaticResource RotuloCampo}" />
            <Border Style="{StaticResource CampoTexto}">
                <Entry Text="{Binding ConfirmarSenha}" Placeholder="Repita a senha" IsPassword="True" VerticalOptions="Center" />
            </Border>

            <Label Text="{Binding MensagemErro}" Style="{StaticResource TextoErro}" Margin="0,4,0,0" />

            <Button Text="Criar Conta"
                    Style="{StaticResource BotaoPrimario}"
                    Command="{Binding CriarContaCommand}"
                    Margin="0,18,0,0" />

            <ActivityIndicator IsRunning="{Binding Carregando}"
                                IsVisible="{Binding Carregando}"
                                Color="{StaticResource AzulPrimario}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
