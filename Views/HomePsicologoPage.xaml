<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             x:Class="MauiApp1.Views.HomePsicologoPage"
             x:DataType="vm:HomePsicologoViewModel"
             Title=""
             BackgroundColor="White"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,20,24,12" Spacing="18">

                <!-- Sino de notificação -->
                <Grid HorizontalOptions="Start" WidthRequest="30" HeightRequest="30" Margin="0,0,0,2">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirNotificacaoCommand}" />
                    </Grid.GestureRecognizers>
                    <Image Source="icone_notificacao.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Start" />
                    <Border IsVisible="{Binding NotificacoesNaoLidas, Converter={StaticResource ContadorParaVisivelConverter}}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="Transparent"
                            BackgroundColor="#E24B4A"
                            Padding="4,1"
                            HorizontalOptions="Start" VerticalOptions="Start"
                            Margin="14,-4,0,0">
                        <Label Text="{Binding NotificacoesNaoLidas}" TextColor="White" FontSize="9" FontAttributes="Bold" />
                    </Border>
                </Grid>

                <!-- Cabeçalho -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="{Binding NomeUsuario, StringFormat='Olá, {0}'}"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AzulEscuro}"
                           VerticalOptions="Center"
                           Margin="0,6,0,0" />
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 24"
                            HeightRequest="48" WidthRequest="48"
                            Padding="0">
                        <Image Source="{Binding FotoExibida}" Aspect="AspectFill" />
                    </Border>
                    <Label Grid.Column="2"
                           Text="Sair"
                           TextColor="{StaticResource AzulPrimario}"
                           FontSize="13"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SairCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Sumário Clínico -->
                <Border StrokeShape="RoundRectangle 18"
                        Stroke="{StaticResource CinzaClaro}"
                        BackgroundColor="#F7F8FA"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Sumário Clínico" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource AzulEscuro}" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" Style="{StaticResource CartaoEstatistica}">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding PacientesAtivos}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource AzulEscuro}" HorizontalOptions="Center" />
                                    <Label Text="Pacientes" FontSize="11" TextColor="{StaticResource AzulEscuro}" HorizontalOptions="Center" />
                                    <Label Text="Ativos" FontSize="10" TextColor="{StaticResource CinzaMedio}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CartaoEstatistica}">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding QuestionariosAtivos}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource AzulEscuro}" HorizontalOptions="Center" />
                                    <Label Text="Questionários" FontSize="11" TextColor="{StaticResource AzulEscuro}" HorizontalOptions="Center" />
                                    <Label Text="Ativos" FontSize="10" TextColor="{StaticResource CinzaMedio}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CartaoEstatistica}">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding RespostasPendentes}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource AzulEscuro}" HorizontalOptions="Center" />
                                    <Label Text="Respostas" FontSize="11" TextColor="{StaticResource AzulEscuro}" HorizontalOptions="Center" />
                                    <Label Text="Pendentes" FontSize="10" TextColor="{StaticResource CinzaMedio}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Acesso Rápido -->
                <Label Text="Acesso Rápido" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource AzulEscuro}" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CartaoAcessoRapido}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirPacientesCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="👥  Pacientes" FontAttributes="Bold" TextColor="{StaticResource AzulEscuro}" VerticalOptions="Center" />
                    </Border>

                    <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CartaoAcessoRapido}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirQuestionariosCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="📝  Questionários" FontAttributes="Bold" TextColor="{StaticResource AzulEscuro}" VerticalOptions="Center" />
                    </Border>

                    <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource CartaoAcessoRapido}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirRelatoriosCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="📊  Relatórios" FontAttributes="Bold" TextColor="{StaticResource AzulEscuro}" VerticalOptions="Center" />
                    </Border>

                    <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CartaoAcessoRapido}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirChatCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="💬  Chat" FontAttributes="Bold" TextColor="{StaticResource AzulEscuro}" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Recentes -->
                <Label Text="Recentes" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource AzulEscuro}" Margin="0,8,0,0" />

                <Border StrokeShape="RoundRectangle 16"
                        Stroke="{StaticResource CinzaClaro}"
                        BackgroundColor="White"
                        Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Ana Souza — Paciente" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource AzulEscuro}" />
                        <Label Text="Entre no chat para visualizar a mensagem." FontSize="12" TextColor="{StaticResource CinzaMedio}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra de navegação inferior -->
        <Grid Grid.Row="1" RowDefinitions="1,Auto" BackgroundColor="White">
            <BoxView Grid.Row="0" HeightRequest="1" Color="{StaticResource CinzaClaro}" />

            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Padding="0,10">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <Label Text="🏠" FontSize="18" HorizontalOptions="Center" />
                    <Label Text="Home" FontSize="10" TextColor="{StaticResource AzulPrimario}" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirChatCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="💬" FontSize="18" HorizontalOptions="Center" />
                    <Label Text="Chat" FontSize="10" TextColor="{StaticResource CinzaMedio}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirQuestionariosCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="📋" FontSize="18" HorizontalOptions="Center" />
                    <Label Text="Questionários" FontSize="9" TextColor="{StaticResource CinzaMedio}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirPerfilCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="👤" FontSize="18" HorizontalOptions="Center" />
                    <Label Text="Perfil" FontSize="10" TextColor="{StaticResource CinzaMedio}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

    </Grid>
</ContentPage>
