<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             x:Class="MauiApp1.Views.DadosPacientePage"
             x:DataType="vm:DadosPacienteViewModel"
             Title=""
             BackgroundColor="White"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="16">

            <ImageButton Source="icone_voltar.svg"
                         Command="{Binding VoltarCommand}"
                         BackgroundColor="Transparent"
                         WidthRequest="36" HeightRequest="36"
                         HorizontalOptions="Start" />

            <Label Text="Dados do Paciente" FontAttributes="Bold" FontSize="20" TextColor="{StaticResource AzulPrimario}" HorizontalOptions="Center" />

            <Label Text="{Binding MensagemErro}" Style="{StaticResource TextoErro}" HorizontalTextAlignment="Center"
                   IsVisible="{Binding MensagemErro, Converter={StaticResource StringNaoVazioConverter}}" />

            <VerticalStackLayout Spacing="12" HorizontalOptions="Center" Margin="0,10,0,0">
                <Border StrokeShape="RoundRectangle 55" WidthRequest="110" HeightRequest="110" Padding="0">
                    <Image Source="{Binding FotoExibida}" Aspect="AspectFill" />
                </Border>
                <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="19" TextColor="{StaticResource AzulEscuro}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource CinzaClaro}" BackgroundColor="#FAFBFC" Padding="16" Margin="0,10,0,0">
                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="🎂" FontSize="16" VerticalOptions="Center" WidthRequest="30" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Idade" FontSize="11" TextColor="{StaticResource CinzaMedio}" />
                            <Label Text="{Binding IdadeExibida}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AzulEscuro}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource CinzaClaro}" />

                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="⚧" FontSize="16" VerticalOptions="Center" WidthRequest="30" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Gênero" FontSize="11" TextColor="{StaticResource CinzaMedio}" />
                            <Label Text="{Binding GeneroExibido}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AzulEscuro}" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Label Text="E-mail, telefone e data de nascimento não são exibidos aqui por privacidade."
                   FontSize="11" TextColor="{StaticResource CinzaMedio}" HorizontalTextAlignment="Center" Margin="0,6,0,0" />

            <ActivityIndicator IsRunning="{Binding Carregando}" IsVisible="{Binding Carregando}" Color="{StaticResource AzulPrimario}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
