<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             x:Class="MauiApp1.Views.HomePacientePage"
             x:DataType="vm:HomePacienteViewModel"
             Title=""
             BackgroundColor="White"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,20,24,12" Spacing="18">

                <!-- Sino de notificação -->
                <Grid HorizontalOptions="Start" WidthRequest="44" HeightRequest="30" Margin="0,0,0,2">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirNotificacaoCommand}" />
                    </Grid.GestureRecognizers>
                    <Image Source="icone_notificacao.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Start" />
                    <Border IsVisible="{Binding NotificacoesNaoLidas, Converter={StaticResource ContadorParaVisivelConverter}}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="Transparent"
                            BackgroundColor="#E24B4A"
                            MinimumWidthRequest="16"
                            Padding="4,1"
                            HorizontalOptions="Start" VerticalOptions="Start"
                            Margin="14,-4,0,0">
                        <Label Text="{Binding NotificacoesNaoLidas}" TextColor="White" FontSize="9" FontAttributes="Bold"
                               LineBreakMode="NoWrap" HorizontalTextAlignment="Center" />
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="{Binding NomeUsuario, StringFormat='Olá, {0}'}"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AzulEscuro}"
                           VerticalOptions="Center"
                           Margin="0,6,0,0" />
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 24"
                            HeightRequest="48" WidthRequest="48"
                            Padding="0">
                        <Image Source="{Binding FotoExibida}" Aspect="AspectFill" />
                    </Border>
                </Grid>

                <!-- Card "Próxima pergunta" — a pergunta mais próxima do
                     horário de resposta, do questionário ativo mais
                     antigo em uso, ainda não respondida hoje. Mesmo
                     visual (claro, cartão) usado nas telas de responder
                     questionário, com os mesmos rostos de escala. -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="{StaticResource CinzaClaro}"
                        BackgroundColor="#FAFBFC"
                        Padding="16"
                        IsVisible="{Binding TemProximaPergunta}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Próxima pergunta" TextColor="{StaticResource AzulPrimario}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding ProximoQuestionarioTitulo}" TextColor="{StaticResource CinzaMedio}" FontSize="12" />

                        <BoxView HeightRequest="1" Color="{StaticResource CinzaClaro}" Margin="0,2" />

                        <Label Text="{Binding ProximaPerguntaTexto}" TextColor="{StaticResource AzulEscuro}" FontSize="15" FontAttributes="Bold" />
                        <Label Text="{Binding ProximoHorario, StringFormat='Deve ser respondida às {0}'}" TextColor="{StaticResource CinzaMedio}" FontSize="11" />

                        <Label Text="{Binding ProximaMensagemErro}" Style="{StaticResource TextoErro}"
                               IsVisible="{Binding ProximaMensagemErro, Converter={StaticResource StringNaoVazioConverter}}" />

                        <!-- Escala: os mesmos rostos usados na tela de
                             responder — dá um leve "pop" no selecionado -->
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,8,0,0"
                                                IsVisible="{Binding ProximaEhEscala}">
                            <Image Source="escala_muito_mal.svg" WidthRequest="40" HeightRequest="40" Scale="{Binding Escala1Tamanho}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelecionarProximaEscalaCommand}" CommandParameter="1" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Source="escala_mal.svg" WidthRequest="40" HeightRequest="40" Scale="{Binding Escala2Tamanho}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelecionarProximaEscalaCommand}" CommandParameter="2" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Source="escala_regular.svg" WidthRequest="40" HeightRequest="40" Scale="{Binding Escala3Tamanho}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelecionarProximaEscalaCommand}" CommandParameter="3" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Source="escala_bem.svg" WidthRequest="40" HeightRequest="40" Scale="{Binding Escala4Tamanho}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelecionarProximaEscalaCommand}" CommandParameter="4" />
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Source="escala_muito_bem.svg" WidthRequest="40" HeightRequest="40" Scale="{Binding Escala5Tamanho}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelecionarProximaEscalaCommand}" CommandParameter="5" />
                                </Image.GestureRecognizers>
                            </Image>
                        </HorizontalStackLayout>

                        <!-- Texto -->
                        <Border Style="{StaticResource CampoTexto}" Margin="0,6,0,0"
                                IsVisible="{Binding ProximaEhTexto}">
                            <Editor Text="{Binding ProximaRespostaTexto}" Placeholder="Escreva sua resposta..." AutoSize="TextChanges" HeightRequest="70" />
                        </Border>

                        <!-- Múltipla Escolha -->
                        <CollectionView ItemsSource="{Binding ProximasOpcoes}" IsVisible="{Binding ProximaEhMultiplaEscolha}" Margin="0,6,0,0">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Style="{StaticResource CampoTexto}" Padding="12,10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelecionarProximaOpcaoCommand}"
                                                                   CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding .}" TextColor="{StaticResource AzulEscuro}" FontAttributes="Bold" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="Enviar"
                                Command="{Binding EnviarProximaPerguntaCommand}"
                                Style="{StaticResource BotaoPrimario}"
                                Margin="0,6,0,0"
                                IsEnabled="{Binding EnviandoProximaPergunta, Converter={StaticResource InversoBoolConverter}}" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 16"
                        Stroke="{StaticResource CinzaClaro}"
                        BackgroundColor="#FAFBFC"
                        Padding="18"
                        IsVisible="{Binding TemProximaPergunta, Converter={StaticResource InversoBoolConverter}}">
                    <Label Text="Nenhuma pergunta pendente por agora. 🎉" TextColor="{StaticResource AzulEscuro}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </Border>

                <!-- Acesso Rápido -->
                <Label Text="Acesso Rápido" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource AzulEscuro}" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                    <Image Grid.Column="0" Grid.Row="0" Source="card_acesso_historico.svg" Aspect="AspectFit">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirHistoricoCommand}" />
                        </Image.GestureRecognizers>
                    </Image>

                    <Image Grid.Column="1" Grid.Row="0" Source="card_acesso_questionarios_paciente.svg" Aspect="AspectFit">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirQuestionariosCommand}" />
                        </Image.GestureRecognizers>
                    </Image>

                    <!-- Card de Chat: mostra a versão com bolinha vermelha só
                         quando existe mensagem/áudio/imagem/documento/feedback
                         não visualizado — outros tipos de notificação (vínculo,
                         resposta de questionário) não acendem esse card. -->
                    <Grid Grid.Column="0" Grid.Row="1">
                        <Image Source="card_acesso_chat_paciente.svg" Aspect="AspectFit"
                               IsVisible="{Binding TemNotificacaoChat, Converter={StaticResource InversoBoolConverter}}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AbrirChatCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Image Source="icone_chat_com_notificao.svg" Aspect="AspectFit"
                               IsVisible="{Binding TemNotificacaoChat}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AbrirChatCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <Image Grid.Column="1" Grid.Row="1" Source="card_acesso_buscar_psicologo.svg" Aspect="AspectFit">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirBuscarPsicologoCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra de navegação inferior (mesmo padrão da Home do Psicólogo) -->
        <Grid Grid.Row="1" RowDefinitions="1,Auto" BackgroundColor="White">
            <BoxView Grid.Row="0" HeightRequest="1" Color="{StaticResource CinzaClaro}" />

            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Padding="0,10">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <Image Source="icone_atalho_home_azul.svg" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                    <Label Text="Home" FontSize="10" TextColor="{StaticResource AzulPrimario}" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirChatCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Image Source="icone_atalho_chat_cinza.svg" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                    <Label Text="Chat" FontSize="10" TextColor="{StaticResource CinzaMedio}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirQuestionariosCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Image Source="icone_atalho_questionarios_cinza.svg" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                    <Label Text="Questionários" FontSize="9" TextColor="{StaticResource CinzaMedio}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirPerfilCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Image Source="icone_atalho_perfil_cinza.svg" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                    <Label Text="Perfil" FontSize="10" TextColor="{StaticResource CinzaMedio}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

    </Grid>
</ContentPage>
